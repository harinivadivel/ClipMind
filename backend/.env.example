# ============================================================
# ClipMind AI — Backend environment variables (EXAMPLE ONLY)
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: `.env` is gitignored and excluded from the Docker image
# (.dockerignore). Never commit real secrets.
# ============================================================

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres2004
POSTGRES_DB=clipmind_ai

# --- App / JWT ---
SECRET_KEY=change_this_to_a_long_random_secret

# --- CORS (browser origins allowed to call the API) ---
# Comma-separated list. Your deployed Vercel frontend is included below.
BACKEND_CORS_ORIGINS=http://localhost:3000,https://clip-mind-frontend.vercel.app

# --- Backend public URL (used to build absolute media URLs) ---
BACKEND_URL=http://localhost:8000

# --- Optional: Google Gemini for quiz generation ---
# Get a key at https://aistudio.google.com/app/apikey
# Replace YOUR_API_KEY with a real key in your .env (never commit real keys).
GOOGLE_API_KEY=YOUR_API_KEY
