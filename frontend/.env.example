# ============================================================================
# ClipMind AI — Frontend environment variables (EXAMPLE ONLY)
#
# Copy to `.env` for local development. For Vercel deployments, set
# VITE_API_URL in the Vercel dashboard (Settings -> Environment Variables),
# NOT in a committed file.
# ============================================================================

# Local dev backend. The Vite dev server proxies /api and /uploads to
# http://localhost:8000 (see vite.config.js), so this can be left unset too.
VITE_API_URL=http://localhost:8000

# Deployed backend (set in Vercel for Production/Preview/Development):
# VITE_API_URL=https://your-backend.onrender.com